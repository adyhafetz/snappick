# Supabase (same project as mobile app)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Admin auth: this Next.js app enforces is_admin() via Supabase RLS
# No service role key in the app; use Supabase Studio for raw DB access
KAGGLE_USERNAME="your_username"
KAGGLE_KEY="KGAT_your_token_copied_from_settings"
KAGGLE_KERNEL_SLUG="your_username/snappick-ml"
# Retraining always pushes to ONE Kaggle notebook (the title must slugify to the slug's name,
# e.g. slug "your_username/snappick-ml" -> title "Snappick ML", the default). Create it by clicking
# Retrain once, then attach the SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY secrets to that notebook.
# KAGGLE_KERNEL_TITLE=Snappick ML
