{
  "expo": {
    "name": "SnapPick",
    "slug": "snappick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "snappick",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.snappick.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": ["android.permission.CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#19806D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      ["expo-camera", { "recordAudioAndroid": false }],
      ["expo-image-picker", { "microphonePermission": false }],
      ["expo-location", { "locationWhenInUsePermission": "Allow SnapPick to use your location only when you request local recycling guidance or choose a pickup point." }],
      ["expo-notifications", { "icon": "./assets/images/notification-icon.png", "color": "#19806d" }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "@react-native-google-signin/google-signin",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
