# Public values (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Site address. Leave as is until the domain is bought; never hard-code the domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Server only. AI for SnapBot answers and report suggestions goes through the dashboard-ai Supabase function,
# which uses the project's OPENAI_API_KEY secret. Set the same value here and with: supabase secrets set DASHBOARD_AI_SECRET=...
# Without it SnapBot answers from built-in rules and the report says "generated automatically".
DASHBOARD_AI_SECRET=
# Local-only alternative that skips Supabase (do not use in production):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# APK download (see docs/PUBLIC_WEBSITE_AND_DASHBOARD.md section 13). Leave empty until a release APK exists.
NEXT_PUBLIC_APK_URL=
NEXT_PUBLIC_APK_VERSION=
NEXT_PUBLIC_APK_SIZE=
NEXT_PUBLIC_APK_SHA256=
